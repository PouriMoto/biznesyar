# ───────── کپی کنید به «.env» (در گیت نیست) ─────────
# این‌ها فقط موقع build/dev خوانده می‌شوند. توجه: متغیرهای PUBLIC_* داخل خروجی سایت هم می‌آیند (برای آدرس‌های عمومی مثل گوگل‌فرم مشکلی نیست؛ رمز و توکن را هرگز PUBLIC نکنید).

# حالت سایت: static (گوگل‌فرم، بدون سرور) یا backend (PocketBase)
SITE_MODE=static
# SITE_URL=https://bizyaar.ir

# گوگل‌فرم لیدها (آدرس formResponse و شناسهٔ entryها)
# PUBLIC_GFORM_ACTION=https://docs.google.com/forms/d/e/XXXX/formResponse
# PUBLIC_GFORM_FIELDS={"name":"entry.1","phone":"entry.2","service":"entry.3","region":"entry.4","message":"entry.5","page":"entry.6","source":"entry.7","utm":"entry.8"}
# در حالت backend لید همزمان به گوگل‌فرم هم برود؟ (۱ = بله، ۰ = خیر)
# PUBLIC_LEADS_MIRROR=1

# آدرس API در حالت backend (در dev خودکار http://127.0.0.1:8090)
# PUBLIC_API_BASE=

# فقط برای build محلی
# SHOW_DRAFTS=1

# ───────── اسرار سرور (روی VPS در /etc/bizyaar.env؛ هرگز در گیت/zip) ─────────
# OTP_SECRET=            # رشتهٔ تصادفی بلند (openssl rand -hex 32). بدون آن ورود با کد کار نمی‌کند
# ADMIN_PHONES=          # شماره‌های ادمین با ویرگول (مثلاً 09xxxxxxxxx,09yyyyyyyyy)
# FLOWS_DIR=/var/www/bizyaar/flows
# SMS_PROVIDER=melipayamak
# MELIPAYAMAK_USER=
# MELIPAYAMAK_PASS=
# MELIPAYAMAK_OTP_BODYID=
# MELIPAYAMAK_NOTIFY_BODYID=
# SMS_MODE=critical      # critical | all | off
# BALE_TOKEN=
# BALE_CHAT_ID=
# BALE_BOT_USERNAME=
# BALE_WEBHOOK_SECRET=
# OTP_VIA_BALE=1
# FILE_RETENTION_DAYS=0
# OTP_DEV=1              # فقط تست محلی؛ هرگز روی سرور واقعی

# ───────── Caddy (روی VPS در /etc/caddy/caddy.env) ─────────
# SITE_DOMAIN=bizyaar.ir
# STUDIO_USER=
# STUDIO_PASS_HASH=      # خروجی: caddy hash-password
