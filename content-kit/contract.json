    "region-entry": {
      "label": "شهر یا منطقه",
      "output": "src/data/regions/{slug}.json",
      "format": "json",
      "preview": "region",
      "inputs": [],
      "fields": [
        {
          "key": "slug",
          "label": "شناسه (انگلیسی)",
          "kind": "text",
          "required": true,
          "help": "حروف کوچک و خط تیره؛ مثل minab. بعداً قابل تغییر نیست."
        },
        {
          "key": "name",
          "label": "نام",
          "kind": "text",
          "required": true,
          "max": 40
        },
        {
          "key": "kind",
          "label": "نوع",
          "kind": "select",
          "required": true,
          "options": [
            [
              "مرکز استان",
              "مرکز استان"
            ],
            [
              "شهرستان",
              "شهرستان"
            ],
            [
              "منطقه آزاد",
              "منطقه آزاد"
            ],
            [
              "بخش",
              "بخش"
            ],
            [
              "استان",
              "استان"
            ]
          ]
        },
        {
          "key": "intro",
          "label": "معرفی کوتاه",
          "kind": "longtext",
          "required": true,
          "min": 40,
          "max": 400,
          "help": "۲ تا ۳ جمله که بالای صفحه شهر نمایش داده می‌شود."
        },
        {
          "key": "featured",
          "label": "در فهرست اصلی بیاید",
          "kind": "bool",
          "default": false
        },
        {
          "key": "order",
          "label": "ترتیب نمایش",
          "kind": "number",
          "default": 500,
          "help": "عدد کوچک‌تر بالاتر. شهرهای فعلی ۱۰ تا ۱۵۰ هستند."
        },
        {
          "key": "notes",
          "label": "نکات محلی",
          "kind": "lines",
          "default": [],
          "help": "هر نکته در یک خط؛ به‌صورت تیک‌لیست در صفحه شهر نمایش داده می‌شود."
        },
        {
          "key": "faq",
          "label": "پرسش‌های متداول",
          "kind": "faq",
          "group": "extra",
          "help": "هر پرسش و پاسخ کوتاه. برای نتیجه‌های گوگل و پاسخ‌گوهای هوشمند مفید است."
        }
      ],
      "rules": [
        {
          "id": "required",
          "level": "error"
        },
