---
import { site } from '../config';
interface Props { service?: string; id?: string; tags?: string[]; category?: string }
const { service, id, tags = [], category = '' } = Astro.props;
// انتخاب فایل: شناسهٔ صریح مقاله ← وگرنه بین فایل‌های هم‌خدمت، آن‌که برچسب/دسته‌اش با مقاله بیشتر می‌خورد ← وگرنه اولی
const all: any[] = (site as any).magnets ?? [];
const pool = id ? all.filter((x) => x.id === id) : all.filter((x) => (x.services ?? []).includes(service));
// برچسب مقاله دو امتیاز، دسته یک امتیاز
const score = (x: any) => (x.tags ?? []).reduce((n: number, t: string) => n + (tags.includes(t) ? 2 : t === category ? 1 : 0), 0);
const m = [...pool].sort((a, b) => score(b) - score(a))[0];
if (id && !m) console.warn(`[لید مگنت] شناسهٔ «${id}» در site.config.json ← magnets پیدا نشد؛ در این مقاله لید مگنتی نمایش داده نمی‌شود.`);
---
{m && (
  <section class="magnet" data-magnet={m.id} data-file={m.file} data-service={service ?? ''}>
    <h3>{m.title}</h3>
    <p style="margin:0">{m.text}</p>
    <form class="inline magnet-form" novalidate>
      <input name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="09123456789" aria-label="شماره موبایل" required />
      <button class="btn btn-primary" type="submit">دریافت رایگان</button>
    </form>
    <p class="lead-status" role="status" hidden></p>
    <p class="magnet-done" hidden><a class="btn btn-primary" href={m.file} download target="_blank" rel="noopener" data-track="magnet_download">⬇ دانلود PDF</a></p>
  </section>
)}
<script>
  import '../scripts/lead-magnet';
</script>
