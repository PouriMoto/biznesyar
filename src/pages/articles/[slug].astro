---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Callout from '../../components/mdx/Callout.astro';
import Figure from '../../components/mdx/Figure.astro';
import Video from '../../components/mdx/Video.astro';
import Mermaid from '../../components/mdx/Mermaid.astro';
import ToolsRelated from '../../components/ToolsRelated.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import LeadForm from '../../components/LeadForm.astro';
import LeadMagnet from '../../components/LeadMagnet.astro';
import Faq from '../../components/Faq.astro';
import { getArticles, related } from '../../lib/content';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../lib/seo';
import { leadsOn } from '../../lib/leads';
import { formatDate, readingMinutes, toFa } from '../../lib/format';

export async function getStaticPaths() {
  const all = await getArticles();
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}
const { entry, all } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const path = `/articles/${entry.id}/`;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const more = related(all, entry);
const og = d.cover ? await getImage({ src: d.cover.src, width: 1200, height: 630, format: 'jpg' }) : null;
---
<BaseLayout
  title={d.title}
  description={d.description}
  ogType="article"
  image={og?.src}
  noindex={d.draft}
  leadHere
  jsonLd={[
    articleSchema({ title: d.title, description: d.description, path, published: d.publishedAt, updated: d.updatedAt, image: og?.src }),
    breadcrumbSchema([{ name: 'خانه', path: '/' }, { name: 'مقالات', path: '/articles/' }, { name: d.title, path }]),
    faqSchema(d.faq)
  ]}
>
  <div class="progress" aria-hidden="true"></div>
  <div class="page-head article-head">
    <div class="container narrow-head">
      <Breadcrumbs items={[{ name: 'مقالات', path: '/articles/' }, { name: d.title }]} />
      <div class="meta">
        <span class="badge">{d.category}</span>
        {d.draft && <span class="badge draft">پیش‌نویس؛ منتشر نمی‌شود</span>}
        <span>{formatDate(d.updatedAt ?? d.publishedAt)}</span>
        <span>{toFa(readingMinutes(entry.body))} دقیقه مطالعه</span>
        {d.reviewedAt && <span class="badge"><Icon name="shield-check" />بازبینی‌شده در {formatDate(d.reviewedAt)}</span>}
      </div>
      <h1>{d.title}</h1>
      <p>{d.description}</p>
    </div>
  </div>

  <div class="container article-layout" data-article>
    {toc.length > 1 && (
      <>
        <nav class="toc toc-desktop" aria-label="فهرست مطالب">
          <h2>در این مقاله</h2>
          <ol>{toc.map((h) => <li class={`l${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
        <details class="toc-mobile">
          <summary>فهرست مطالب</summary>
          <ol>{toc.map((h) => <li class={`l${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </details>
      </>
    )}
    <article>
      {d.cover && (
        <figure class="cover">
          <Image src={d.cover.src} alt={d.cover.alt} widths={[480, 800, 1200]} sizes="(min-width: 1000px) 44rem, 100vw" loading="eager" fetchpriority="high" />
          {d.cover.caption && <figcaption class="meta" style="justify-content:center;margin-top:.5rem">{d.cover.caption}</figcaption>}
        </figure>
      )}
      <div class="prose"><Content components={{ Callout, Figure, Video, Mermaid }} /></div>

      <ToolsRelated articleId={entry.id} />

      <Faq items={d.faq} />

      {d.sources.length > 0 && (
        <section class="sources" style="margin-top:2rem">
          <h2 style="font-size:1.1rem">منابع</h2>
          <ul>{d.sources.map((s) => <li>{s.url ? <a href={s.url} rel="noopener nofollow" target="_blank">{s.title}</a> : s.title}</li>)}</ul>
        </section>
      )}

      {d.magnet !== false && leadsOn('magnet') && <LeadMagnet service={d.service} id={typeof d.magnet === 'string' ? d.magnet : undefined} tags={d.tags ?? []} category={d.category} />}
      {d.leadForm && (
        <div class="article-cta">
          <LeadForm compact service={d.service ?? ''} region={d.region ?? ''} heading="این مسیر را به ما بسپارید" sub="شماره‌تان را بگذارید تا درباره پرونده شما مشاوره رایگان بدهیم." formName={`article_${entry.id}`} id="lead" placement="article" />
        </div>
      )}

      {more.length > 0 && (
        <section style="margin-top:3rem">
          <h2>مقالات مرتبط</h2>
          <div class="art-list">
            {more.map((a) => (
              <a class="art-item" href={`/articles/${a.id}/`}>
                {a.data.cover && (
                  <span class="art-thumb">
                    <Image src={a.data.cover.src} alt={a.data.cover.alt} width={110} height={110} loading="lazy" />
                  </span>
                )}
                <span class="art-item-body">
                  <div class="meta"><span class="badge">{a.data.category}</span><span>{formatDate(a.data.publishedAt)}</span></div>
                  <h3>{a.data.title}</h3><p>{a.data.description}</p>
                </span>
              </a>
            ))}
          </div>
        </section>
      )}
    </article>
  </div>
</BaseLayout>
