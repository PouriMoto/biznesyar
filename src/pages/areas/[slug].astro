---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import LeadForm from '../../components/LeadForm.astro';
import LeadMagnet from '../../components/LeadMagnet.astro';
import Faq from '../../components/Faq.astro';
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Callout from '../../components/mdx/Callout.astro';
import Figure from '../../components/mdx/Figure.astro';
import { enabledServices, getRegions, getArticles } from '../../lib/content';
import { breadcrumbSchema, faqSchema, abs } from '../../lib/seo';
import { formatDate } from '../../lib/format';
import { leadsOn } from '../../lib/leads';
import { site } from '../../config';

export function getStaticPaths() {
  return getRegions().map((r) => ({ params: { slug: r.slug }, props: { r } }));
}
const { r } = Astro.props;
const services = enabledServices();
const entry = await getEntry('areas', r.slug);
const Body = entry ? (await render(entry)).Content : null;
const faqItems = [...r.faq, ...(entry?.data.faq ?? [])];
const arts = (await getArticles()).filter((a) => a.data.region === r.slug).slice(0, 4);
const path = `/areas/${r.slug}/`;
const title = `خدمات کسب‌وکار و جواز کسب در ${r.name}`;
const desc = `${site.brand.name_fa}؛ مشاوره و پیگیری جواز کسب و امور اداری کسب‌وکار در ${r.name}. مشاوره اولیه رایگان.`;
const local = {
  '@context': 'https://schema.org', '@type': 'ProfessionalService', name: `${site.brand.name_fa} در ${r.name}`, url: abs(path),
  parentOrganization: { '@id': abs('/#org') }, areaServed: { '@type': 'AdministrativeArea', name: r.name }
};
---
<BaseLayout title={title} description={desc} jsonLd={[breadcrumbSchema([{ name: 'خانه', path: '/' }, { name: r.name, path }]), faqSchema(faqItems), local]} leadHere>
  <div class="page-head">
    <div class="container">
      <Breadcrumbs items={[{ name: r.name }]} />
      <h1>{title}</h1>
      <p>{r.intro}</p>
    </div>
  </div>
  <div class="container aside-layout">
    <div>
      {entry?.data.cover && (
        <figure class="cover"><Image src={entry.data.cover.src} alt={entry.data.cover.alt} widths={[480, 800, 1200]} sizes="(min-width: 900px) 40rem, 100vw" loading="eager" />{entry.data.cover.caption && <figcaption class="meta" style="justify-content:center;margin-top:.5rem">{entry.data.cover.caption}</figcaption>}</figure>
      )}
      {Body && <div class="prose block"><Body components={{ Callout, Figure }} /></div>}
      <section class="block">
        <h2>خدمات در {r.name}</h2>
        <div class="rows">
          {services.map((s) => (
            <a class="row-item" href={`/services/${s.slug}/`}>
              <span class="ico"><Icon name={s.icon} /></span>
              <span><h3>{s.title}</h3><p>{s.short}</p></span>
              <Icon name="arrow-left" class="go" />
            </a>
          ))}
        </div>
      </section>
      {r.notes.length > 0 && (
        <section class="block">
          <h2>نکات مهم برای {r.name}</h2>
          <ul class="check">{r.notes.map((n: string) => <li><Icon name="check" /><span>{n}</span></li>)}</ul>
        </section>
      )}
      {leadsOn('magnet') && <LeadMagnet service="business-license" />}
      <div class="block"><Faq items={faqItems} /></div>
      {arts.length > 0 && (
        <section class="block">
          <h2>مقالات مرتبط با {r.name}</h2>
          <div class="art-list">
            {arts.map((a) => (
              <a class="art-item" href={`/articles/${a.id}/`}>
                {a.data.cover && (
                  <span class="art-thumb">
                    <Image src={a.data.cover.src} alt={a.data.cover.alt} width={110} height={110} loading="lazy" />
                  </span>
                )}
                <span class="art-item-body">
                  <div class="meta"><span class="badge">{a.data.category}</span><span>{formatDate(a.data.publishedAt)}</span></div>
                  <h3>{a.data.title}</h3><p>{a.data.description}</p>
                </span>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
    <aside class="sticky"><LeadForm region={r.slug} heading="مشاوره رایگان" sub={`برای کسب‌وکار در ${r.name} شماره‌تان را بگذارید.`} formName={`area_${r.slug}`} placement="area" /></aside>
  </div>
</BaseLayout>
